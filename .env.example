# Copy to .env and fill in real values. .env is gitignored — never commit it.

# Deployer key, broadcasts every tx in scripts/DeployOnchainID.s.sol. Needs testnet ETH
# on the target chain (baseSepolia below).
DEPLOYER_PRIVATE_KEY=

# Alchemy API key backing the baseSepolia/base RPC endpoints in foundry.toml.
ALCHEMY_KEY=

# Basescan API key, for `forge script --verify` on baseSepolia/base.
BASESCAN_API_KEY=

# Optional. If set and different from the deployer's address, the script rotates
# ADMIN_ROLE + ROLE_BEACON_UPGRADER to this address and revokes both from the deployer.
# Leave unset to keep the deployer in control (fine for a throwaway/dev deploy).
FINAL_ADMIN_ADDRESS=


# RPC URL for our own testnet
ZENITH_RPC=