{
  "name": "@t-rex-network/onchainid",
  "version": "3.0.0",
  "description": "ONCHAINID smart contracts: digital identities for the T-REX ecosystem. ERC-734/ERC-735 identities built on a modular ERC-7579 smart account with ERC-4337 support.",
  "license": "GPL-3.0-or-later",
  "author": "Digital Asset Operational Services ISAC Ltd. (https://www.trex.network)",
  "type": "module",
  "files": [
    "contracts",
    "out",
    "NOTICE.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/T-REX-Network/ONCHAINID.git"
  },
  "keywords": [
    "onchainid",
    "identity",
    "erc734",
    "erc735",
    "erc7579",
    "erc4337",
    "erc3643",
    "t-rex",
    "trex-network",
    "ethereum",
    "solidity",
    "smart contracts"
  ],
  "bugs": {
    "url": "https://github.com/T-REX-Network/ONCHAINID/issues"
  },
  "homepage": "https://github.com/T-REX-Network/ONCHAINID#readme",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepare": "husky && forge soldeer install",
    "build": "forge build",
    "test": "forge test",
    "lint": "forge fmt --check",
    "lint:fix": "forge fmt",
    "coverage": "forge coverage --no-match-coverage \"(test|script|dependencies|node_modules|FormatResolver|vendor)\" --ir-minimum",
    "coverage:report": "mkdir -p coverage && forge coverage --no-match-coverage \"(test|script|dependencies|node_modules|FormatResolver|vendor)\" --ir-minimum --report lcov --report-file coverage/lcov.info && genhtml coverage/lcov.info -o coverage/report --branch-coverage && open coverage/report/index.html",
    "docs": "forge doc --serve --open",
    "clean": "forge clean"
  },
  "devDependencies": {
    "@ballcat/commitlint-config-gitmoji": "^1.1.0",
    "@commitlint/cli": "^19.8.1",
    "husky": "^9.1.7"
  },
  "commitlint": {
    "extends": [
      "@ballcat/commitlint-config-gitmoji"
    ],
    "parserPreset": {
      "parserOpts": {
        "headerPattern": "^(:\\w*:|(?:[\\u2700-\\u27BF]|[\\uD83C-\\uDBFF][\\uDC00-\\uDFFF]|[\\u2600-\\u26FF]|[\\u2700-\\u27BF]|[\\u00A9\\u00AE]|[\\u203C\\u2049]|[\\u2139]|[\\u2194-\\u21AA]|[\\u231A-\\u25FC]|[\\u25FB-\\u25FE]|[\\u2934-\\u2935]|[\\u2B05-\\u2B55]|[\\u3030\\u303D]|[\\u3297\\u3299]|\\uFE0F)+) (?:\\((.*)\\) )?(.*)$",
        "headerCorrespondence": ["type", "scope", "subject"]
      }
    },
    "rules": {
      "type-enum": [0],
      "type-case": [0]
    }
  }
}
